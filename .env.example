# ── Supabase (required) ────────────────────────────────────────
# Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this deployment. Used to build magic-link redirects and the
# link inside admin notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sheets mirror (optional) ────────────────────────────
# Deployed Apps Script web-app URL, ending in /exec. Leave blank and
# submissions still save to Postgres — only the spreadsheet copy is skipped.
SHEETS_ENDPOINT=

# Shared secret, must match TOKEN in google-apps-script/StorePurchase.gs.
SHEETS_TOKEN=

# ── Admin email alerts (optional) ──────────────────────────────
# Without these, access requests simply wait in /admin with no email sent.
ADMIN_EMAIL=
RESEND_API_KEY=
MAIL_FROM=Luna Forms <noreply@yourdomain.example>
